{
  "Callout: Note": {
    "prefix": ["note"],
    "body": ["> [!NOTE]", "> $1"],
    "description": "Insert Note callout"
  },
  "Callout: Tip": {
    "prefix": ["tip"],
    "body": ["> [!TIP]", "> $1"],
    "description": "Insert Tip callout"
  },
  "Callout: Important": {
    "prefix": ["important"],
    "body": ["> [!IMPORTANT]", "> $1"],
    "description": "Insert Important callout"
  },
  "Callout: Warning": {
