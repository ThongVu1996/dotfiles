# ==============================================================================
# SKHD Configuration (Clean Architecture)
# ==============================================================================
# Modifiers:
# Hyper = cmd + alt + ctrl + shift

# --- [ Application Launchers (Hyper) ] ---

# Hyper + A: Antigravity
cmd + alt + ctrl + shift - a : open -a "/Applications/Antigravity.app"

# Hyper + V: Auto-type (Super Paste) the latest screenshot path
cmd + alt + ctrl + shift - v : osascript -e 'tell application "System Events" to keystroke "/private/tmp/ss_tmp.png "'

# Hyper + K: KeePassXC
cmd + alt + ctrl + shift - k : open -a "$HOME/Applications/Home Manager Trampolines/KeePassXC.app"

# Hyper + B: Zen Browser
cmd + alt + ctrl + shift - b : open -a "/Applications/Zen.app"

# Hyper + O: OrbStack
cmd + alt + ctrl + shift - o : open -a "$HOME/Applications/Home Manager Trampolines/OrbStack.app"

# Hyper + T: Rio Terminal
cmd + alt + ctrl + shift - t : open -a "$HOME/Applications/Home Manager Trampolines/Rio.app"

# Hyper + E: Finder (Home)
cmd + alt + ctrl + shift - e : open $HOME

# --- [ System Actions (Hyper) ] ---

# Hyper + S: Sleep Mac
cmd + alt + ctrl + shift - s : pmset displaysleepnow

# Hyper + M: Mute/Unmute Microphone (Toggle)
cmd + alt + ctrl + shift - m : osascript -e 'if (get volume settings)'"'"'s input volume = 0 then set volume input volume 100 else set volume input volume 0 end if'

# Hyper + L: Lock Screen
cmd + alt + ctrl + shift - l : /System/Library/CoreServices/Menu\ Extras/User.menu/Contents/Resources/CGSession -suspend

# Hyper + D (Chụp vùng chọn)
cmd + alt + ctrl + shift - d : ~/nix-config/dotfiles/skhd/scripts/screenshot.sh -i

# Hyper + F (Chụp toàn màn hình)
cmd + alt + ctrl + shift - f : ~/nix-config/dotfiles/skhd/scripts/screenshot.sh

# Hyper + R: Reload AeroSpace Config
cmd + alt + ctrl + shift - r : aerospace reload-config

# ==============================================================================
# CONTEXT-AWARE SHORTCUTS (via Dispatcher Script)
# Signal from Kanata Space Layer → SKHD dispatches based on focused app
# ==============================================================================

# F13 (Space + Q): Quit current app
f13 : osascript -e 'tell application "System Events" to set frontApp to name of first application process whose frontmost is true' -e 'tell application frontApp to quit'

# F16 (Space + S): Tmux Split-H (Rio) / Save (other apps)
f16 : $HOME/nix-config/dotfiles/skhd/scripts/skhd_dispatcher.sh "s" "cmd - s"

# F17 (Space + Y): Tmux Split-V (Rio) / Save (other apps)
f17 : $HOME/nix-config/dotfiles/skhd/scripts/skhd_dispatcher.sh "v" "cmd - s"

# --- [ Tmux Actions (Terminal Only) ] ---

# F18 (Space + Z): Zoom pane (Rio only)
f18 : $HOME/nix-config/dotfiles/skhd/scripts/skhd_dispatcher.sh "z" ""

# F19 (Space + X): Context-aware Kill (handled in dispatcher)
f19 : $HOME/nix-config/dotfiles/skhd/scripts/skhd_dispatcher.sh "x" ""

# Shift+F13 (Space + ,): Tmux previous window (Prefix + p)
shift - f13 : $HOME/nix-config/dotfiles/skhd/scripts/skhd_dispatcher.sh "p" ""

# Shift+F14 (Space + .): Tmux next window (Prefix + n)
shift - f14 : $HOME/nix-config/dotfiles/skhd/scripts/skhd_dispatcher.sh "n" ""

# Shift+F15 (Space + /): Tmux new window (Prefix + c)
shift - f15 : $HOME/nix-config/dotfiles/skhd/scripts/skhd_dispatcher.sh "c" ""

# Shift+F16 (Space + V): Split pane vertically (Rio only)
shift - f16 : $HOME/nix-config/dotfiles/skhd/scripts/skhd_dispatcher.sh "v" ""

# Shift+F17 (Space + G): Tmux session/window chooser (Rio only)
shift - f17 : $HOME/nix-config/dotfiles/skhd/scripts/skhd_dispatcher.sh "w" ""

# Shift+F18 (Space + T): Sesh session chooser (Rio only)
shift - f18 : $HOME/nix-config/dotfiles/skhd/scripts/skhd_dispatcher.sh "t" ""
